# FlyBot configuration. Copy to .env (repo root; the server and the client build both read it)
# and fill in. Lines left empty use the default shown in server/src/config/env.js.
# Never commit .env: it holds secrets.

# ---------- Server ----------
NODE_ENV=development
PORT=3003
MONGO_URI=mongodb://localhost:27017/ezviz_manager
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Public URL of the web app, used in email links (password reset, invitations)
APP_BASE_URL=http://localhost:3000
# true when served over HTTPS
COOKIE_SECURE=false
# Extra origins allowed to call the API cross-origin, comma-separated (same-origin needs nothing)
CORS_ORIGINS=
# Behind a reverse proxy / Cloud Run: 1, so rate limits see the real client IP
TRUST_PROXY=
# false on every instance but one, so captures and cleanup do not run twice
ENABLE_CRON=true
# false to close public sign-up (admins can also change it in Settings > System)
ALLOW_REGISTRATION=true
# Months of snapshots kept (admins can change it in Settings > System)
RETENTION_CYCLE=3
# Cameras captured and analyzed at the same time (1-20)
CAPTURE_CONCURRENCY=4

# ---------- EZVIZ Open Platform ----------
APP_KEY=
SECRET_KEY=
EZVIZ_DOMAIN=https://ivnopen.ezvizlife.com
# true: the video player gets a per-user EZVIZ sub-account token limited to that user's cameras
# instead of the app account token. Check it first (DEPLOY.md, Known risks).
EZVIZ_RAM_TOKENS=false

# ---------- Snapshot storage (S3-compatible, private bucket) ----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Leave empty: images are served through /api/s3 with access checks
S3_PUBLIC_URL=

# ---------- AI ----------
# vertex, roboflow or both
AI_PROVIDER=roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_URL=
# Vertex AI (Gemini) for the assistant and the "vertex" provider
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# Service account JSON for Vertex AI (local runs; Cloud Run uses its own identity)
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json

# Optional: send reviewed photos to a Roboflow project for retraining (empty = off).
# Needs the workspace's private API key; falls back to ROBOFLOW_API_KEY.
ROBOFLOW_UPLOAD_PROJECT=
ROBOFLOW_UPLOAD_API_KEY=
ROBOFLOW_UPLOAD_CLASS=fruit_fly

# ---------- Email (optional; without SMTP_HOST emails are only logged) ----------
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender; empty = "FlyBot <SMTP_USER>" when SMTP_USER is an email address
MAIL_FROM=
# Public contact address (legal pages) and where the contact form goes;
# empty = SMTP_USER when it is an email address, otherwise the admins
CONTACT_EMAIL=

# ---------- Telegram alerts (optional) ----------
# From @BotFather; username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------- Web push (optional) ----------
# Create the pair with `node server/scripts/generate_vapid_keys.js`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- Webhooks ----------
# Development only: allow webhooks to private addresses (a local test receiver). Ignored in production.
WEBHOOK_ALLOW_PRIVATE=

# ---------- Client build ----------
# Google Maps key for the map tiles (restrict it to your domain)
VITE_GOOGLE_MAP_KEY=
