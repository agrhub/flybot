# FlyBot configuration. Copy to .env (repo root; the server and the client build both read it)
# and fill in. Lines left empty use the default shown in server/src/config/env.js.
# Never commit .env: it holds secrets.

# ---------- Server ----------
NODE_ENV=development
PORT=3003
MONGO_URI=mongodb://localhost:27017/ezviz_manager
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Public URL of the web app, used in email links (password reset, invitations)
APP_BASE_URL=http://localhost:3000
# true when served over HTTPS
COOKIE_SECURE=false
# Extra origins allowed to call the API cross-origin, comma-separated (same-origin needs nothing)
CORS_ORIGINS=
# Behind a reverse proxy / Cloud Run: 1, so rate limits see the real client IP
TRUST_PROXY=
# false on every instance but one, so captures and cleanup do not run twice
ENABLE_CRON=true
# false to close public sign-up (admins can also change it in Settings > System)
ALLOW_REGISTRATION=true
# Months of snapshots kept (admins can change it in Settings > System)
RETENTION_CYCLE=3
# Cameras captured and analyzed at the same time (1-20)
CAPTURE_CONCURRENCY=4

# ---------- EZVIZ Open Platform ----------
APP_KEY=
SECRET_KEY=
EZVIZ_DOMAIN=https://ivnopen.ezvizlife.com
# true: the video player gets a per-user EZVIZ sub-account token limited to that user's cameras
# instead of the app account token. Check it first (DEPLOY.md, Known risks).
EZVIZ_RAM_TOKENS=false

# ---------- Snapshot storage (S3-compatible, private bucket) ----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Leave empty: images are served through /api/s3 with access checks
S3_PUBLIC_URL=

# ---------- AI ----------
# vertex, roboflow, both, opencv-lambda (the flybot-aws vision Lambda, API.md) or sentinel (the first competition build)
AI_PROVIDER=roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/camos/workflows/fruit-fly-vfly-dataset-blzlm-a9mpu-2-rfdetr-small-t1-logic
# Vertex AI (Gemini) for the assistant and the "vertex" provider
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
# Service account JSON for Vertex AI (local runs; Cloud Run uses its own identity)
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json

# Optional: send reviewed photos to a Roboflow project for retraining (empty = off).
# Needs the workspace's private API key; falls back to ROBOFLOW_API_KEY.
ROBOFLOW_UPLOAD_PROJECT=
ROBOFLOW_UPLOAD_API_KEY=
ROBOFLOW_UPLOAD_CLASS=fruit_fly

# ---------- Email (optional; without SMTP_HOST emails are only logged) ----------
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender; empty = "FlyBot <SMTP_USER>" when SMTP_USER is an email address
MAIL_FROM=
# Public contact address (legal pages) and where the contact form goes;
# empty = SMTP_USER when it is an email address, otherwise the admins
CONTACT_EMAIL=
APP_BASE_URL=

# ---------- Telegram alerts (optional) ----------
# From @BotFather; username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------- Web push (optional) ----------
# Create the pair with `node server/scripts/generate_vapid_keys.js`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- FlyBot Sentinel internal API (optional, API.md) ----------
# Shared HMAC key with the Sentinel agent (at least 32 characters). Empty = /api/sentinel answers 503.
SENTINEL_API_SECRET=
# Extra captures Sentinel may ask for, per camera per farm day (default 4)
SENTINEL_CAPTURE_BUDGET=4
# Hours a Sentinel proposal waits for Confirm before it expires (default 24)
SENTINEL_PROPOSAL_TTL_HOURS=24
# Sentinel console (menu Sentinel, read from this database): on with AI_PROVIDER=opencv-lambda, or true here
SENTINEL_CONSOLE=false

# ---------- AWS (flybot-aws: vision Lambda, IoT Core cameras, KVS live view; API.md) ----------
# Credentials: the EC2 instance role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN)
AWS_REGION=ap-southeast-2
# AI_PROVIDER=opencv-lambda: the Lambda name (SDK invoke), or for local development the local Lambda's URL
# (uv run python -m sentinel.lambda_local). The URL wins when both are set. Timeout in seconds.
VISION_LAMBDA_NAME=
VISION_LAMBDA_URL=
VISION_LAMBDA_TIMEOUT_S=120
# true when the photo bucket is real S3 the Lambda reads by bucket/key (default: S3_ENDPOINT empty or amazonaws.com);
# false sends signed URLs (MinIO)
PHOTOS_BY_REFERENCE=
# AWS IoT Core data endpoint (aws iot describe-endpoint --endpoint-type iot:Data-ATS)
IOT_ENDPOINT=
# Camera->cloud messages: mqtt (FlyBot subscribes over WebSocket with SigV4, on the ENABLE_CRON instance),
# rule (an IoT rule posts them to /api/device/events with IOT_RULE_SECRET), off
IOT_EVENTS=mqtt
IOT_RULE_SECRET=
# IAM role the browser assumes (through FlyBot, 15 min) to watch a CamOS camera over KVS WebRTC
KVS_VIEWER_ROLE_ARN=
# Public base URL the cameras call (default APP_BASE_URL)
DEVICE_API_BASE_URL=
# Firmware offered to the cameras by GET /api/device/ota (all three set = offered)
DEVICE_OTA_FW=
DEVICE_OTA_URL=
DEVICE_OTA_SHA256=
# ---------- Workspaces and plans (API.md "Workspaces and plans") ----------
# hybrid (default, flybot.agrhub.com): open sign-up makes a personal workspace on FREE, organizations
#   (made by the admin) exist alongside, pricing page with an "Organization: contact us" card
# b2c: personal workspaces only. b2b: organizations only, sign-up by invitation, no pricing page
APP_MODE=hybrid
# b2b only: true opens sign-up to everyone (new accounts then wait for an organization)
ALLOW_SIGNUP=false
# true: delete photos older than the workspace plan's retentionDays (hourly); false: only the admin's
# global retention (Settings) applies
PLAN_RETENTION=false

# Zero-touch self-registration of the public firmware (POST /api/device/register; false = 503)
SELF_REGISTRATION=true
# Thing type and device policy the stack made (flybot-aws infra)
IOT_THING_TYPE=camos-camera
IOT_POLICY_NAME=camos-camera
# Registrations per client IP per hour, and in total per hour
REGISTER_MAX_PER_IP_HOUR=5
REGISTER_MAX_PER_HOUR=60
# The FREE plan's first values (cameras per workspace, photos per camera a day, minutes per live
# request); after the first start the admin edits the plans in Admin > Plans. DEMO_MAX_UNCLAIMED:
# self-registered cameras waiting to be claimed. Admins and the comma-separated DEMO_EXEMPT_EMAILS
# have no limits
DEMO_MAX_CAMERAS_PER_USER=3
DEMO_MAX_SNAPSHOTS_PER_DAY=48
DEMO_MAX_UNCLAIMED=200
DEMO_LIVE_MINUTES=5
DEMO_EXEMPT_EMAILS=
# GET /api/device/time when neither farm, GPS nor IP gives a timezone
DEVICE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Secrets Manager: comma-separated secret names whose JSON fills in the values not set here (AWS only)
FLYBOT_SECRETS=

# ---------- Webhooks ----------
# Development only: allow webhooks to private addresses (a local test receiver). Ignored in production.
WEBHOOK_ALLOW_PRIVATE=

# ---------- Client build ----------
# Google Maps key for the map tiles (restrict it to your domain)
VITE_GOOGLE_MAP_KEY=
# Optional: video for the home page instead of the built-in product tour
# (an mp4 URL, or a YouTube/Vimeo embed link such as https://www.youtube.com/embed/VIDEO_ID)
VITE_HOME_VIDEO_URL=
