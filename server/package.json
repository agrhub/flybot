{
  "name": "flybot-server",
  "version": "1.0.0",
  "description": "FlyBot API server: EZVIZ cameras, AI insect detection, alerts",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "node --watch src/app.js",
    "copy:client": "node scripts/copy-client.js",
    "build": "esbuild src/app.js --bundle --platform=node --packages=external --outfile=dist/app.js && node scripts/copy-client.js",
    "test": "node --test"
  },
  "keywords": [],
